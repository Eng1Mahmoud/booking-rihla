# Fixed backend URL used only on the Next.js server.
API_BASE_URL=http://127.0.0.1:4000/api/v1

# Website origin used to validate browser requests. Set to your HTTPS domain in production.
SITE_ORIGIN=http://localhost:3000

# Server-only JWT verification key: use the same 64-character hex value as apps/api/.env.
# Never prefix this name with NEXT_PUBLIC_ or commit your actual value.
AUTH_ACCESS_SECRET=

# The browser uses /api/backend on the website host; no secret is sent to browser JavaScript.

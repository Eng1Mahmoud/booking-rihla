# Fixed backend URL used only on the Next.js server.
API_BASE_URL=http://127.0.0.1:4000/api/v1

# Website origin used to validate browser requests. Set to your HTTPS domain in production.
SITE_ORIGIN=http://localhost:3000

# Session and current role are verified by the backend. No JWT signing secret is needed here.

# Browser mutations use Server Actions; only payment status uses a GET route. No secret is sent to browser JavaScript.

# Optional signed client IP for API throttling: configure both values together.
# Ingress MUST overwrite this header with one IP and prevent direct access to Next.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# API_CLIENT_CONTEXT_SECRET=independent-64-hex-key-shared-only-with-the-api

# Match the API assistant deadline; the streaming proxy allows five extra seconds.
AI_REQUEST_TIMEOUT_MS=30000

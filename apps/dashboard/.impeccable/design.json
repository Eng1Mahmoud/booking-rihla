  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Default action; forms raise height to 48px and date controls to 50px on desktop.",
      "html": "<button class=\"ds-primary\">Apply date</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:8px 16px;height:40px;font-family:'Segoe UI',Arial,sans-serif;font-size:14px;font-weight:500;transition:background-color .2s,color .2s,border-color .2s,box-shadow .2s,transform .2s;cursor:pointer;background:var(--ocean,#006f7b);color:#fff;box-shadow:0 4px 12px -6px #006f7b70}.ds-primary:hover{background:color-mix(in oklab,var(--ocean,#006f7b) 90%,transparent)}.ds-primary:focus-visible{outline:3px solid var(--focus,#4eacd8);outline-offset:4px;border-color:var(--ocean,#006f7b);box-shadow:0 0 0 3px rgb(0 111 123 / .5);}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-outline,.ds-ghost,.ds-field{transition:none;animation:none}}"
    },
    {
      "name": "Outline refresh button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Independent report refresh control, with a 44px minimum target.",
      "html": "<button class=\"ds-outline\">Refresh</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:8px 16px;height:40px;font-family:'Segoe UI',Arial,sans-serif;font-size:14px;font-weight:500;transition:background-color .2s,color .2s,border-color .2s,box-shadow .2s,transform .2s;cursor:pointer;height:44px;background:var(--canvas,#f5f8f8);color:var(--ink,#183648);border:1px solid var(--border,#dce6e8);box-shadow:0 1px 2px 0 rgb(0 0 0 / .05)}.ds-outline:hover{background:var(--color-accent,#eaf3f2);color:var(--navy,#112f45)}.ds-outline:focus-visible{outline:3px solid var(--focus,#4eacd8);outline-offset:4px;border-color:var(--ocean,#006f7b);box-shadow:0 0 0 3px rgb(0 111 123 / .5);}.ds-outline:active{transform:translateY(1px)}.ds-outline:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-outline,.ds-ghost,.ds-field{transition:none;animation:none}}"
    },
    {
      "name": "Ghost menu button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "44px utility target used for mobile menu and sign out.",
      "html": "<button class=\"ds-ghost\" aria-label=\"Open navigation\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:8px 16px;height:40px;font-family:'Segoe UI',Arial,sans-serif;font-size:14px;font-weight:500;transition:background-color .2s,color .2s,border-color .2s,box-shadow .2s,transform .2s;cursor:pointer;width:44px;height:44px;padding:0;background:transparent;color:var(--ink,#183648)}.ds-ghost:hover{background:var(--color-accent,#eaf3f2);color:var(--navy,#112f45)}.ds-ghost:focus-visible{outline:3px solid var(--focus,#4eacd8);outline-offset:4px;border-color:var(--ocean,#006f7b);box-shadow:0 0 0 3px rgb(0 111 123 / .5);}.ds-ghost:active{transform:translateY(1px)}.ds-ghost:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-outline,.ds-ghost,.ds-field{transition:none;animation:none}}"
    },
    {
      "name": "Labeled date field",
      "kind": "input",
      "refersTo": "field",
      "description": "Actual form override: white surface, linked label and native date semantics.",
      "html": "<label class=\"ds-label\" for=\"ds-date\">Departure date</label><input class=\"ds-field\" id=\"ds-date\" type=\"date\" value=\"2026-10-25\" min=\"2000-01-01\" max=\"9998-12-31\">",
      "css": ".ds-label{display:block;font-family:'Segoe UI',Arial,sans-serif;font-size:14px;font-weight:500;line-height:1.375;margin-bottom:8px;color:var(--ink,#183648)}.ds-field{display:block;width:100%;min-width:0;height:48px;padding:4px 12px;border:1px solid var(--border,#dce6e8);border-radius:12px;background:#fff;color:var(--ink,#183648);font-family:'Segoe UI',Arial,sans-serif;font-size:16px;caret-color:var(--ocean,#006f7b);outline:none;transition:color .15s,box-shadow .15s}.ds-field:focus-visible{border-color:var(--ocean,#006f7b);box-shadow:0 0 0 3px rgb(0 111 123 / .5)}.ds-field[aria-invalid=true]{border-color:var(--color-destructive,#b42318);box-shadow:0 0 0 3px rgb(180 35 24 / .2)}.ds-field:disabled{opacity:.5;pointer-events:none;cursor:not-allowed}@media(min-width:768px){.ds-field{font-size:14px}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-outline,.ds-ghost,.ds-field{transition:none;animation:none}}"
    },
    {
      "name": "Report navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Start-side navy navigation with a fixed overview current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Dashboard navigation\"><a href=\"#overview\" aria-current=\"page\">Overview</a><a href=\"#operations\">Operations</a><a href=\"#payments\">Payment outcomes</a></nav>",
      "css": ".ds-nav{display:grid;gap:5px;padding:14px;background:var(--navy,#112f45);font-family:'Segoe UI',Arial,sans-serif}.ds-nav a{display:flex;align-items:center;gap:16px;min-height:56px;padding:14px 18px;border-radius:10px;color:#fff;font-size:15px;text-decoration:none}.ds-nav a[aria-current=page]{background:#0b6372}.ds-nav a:hover{background:#24485a}.ds-nav a:focus-visible{outline:3px solid var(--focus,#4eacd8);outline-offset:4px}"
    },
    {
      "name": "Operational report panel",
      "kind": "card",
      "refersTo": "report-panel",
      "description": "Flat panel with circular icon and divided metric rows; sample values illustrate its form.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-report-heading\"><span><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 16V3a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v13M4 16h16M4 16v4M20 16v4M4 6h16M12 6v7M4 13h16\"/><circle cx=\"7.5\" cy=\"17.5\" r=\".5\"/><circle cx=\"16.5\" cy=\"17.5\" r=\".5\"/></svg></span><h2>Trips</h2></div><dl class=\"ds-metrics\"><div><dt>Total</dt><dd>24</dd></div><div><dt><span class=\"ds-dot\"></span>Upcoming</dt><dd>18</dd></div></dl></section>",
      "css": ".ds-panel{min-width:0;border:1px solid var(--border,#dce6e8);border-radius:16px;background:#fff;padding:24px;font-family:'Segoe UI',Arial,sans-serif;color:var(--ink,#183648)}.ds-report-heading{display:flex;align-items:center;gap:22px;margin-bottom:12px}.ds-report-heading>span{display:flex;align-items:center;justify-content:center;width:72px;height:72px;flex-shrink:0;border-radius:50%;background:#edf8f8;color:var(--ocean,#006f7b)}.ds-report-heading h2{margin:0;font-size:clamp(21px,1.7vw,27px);font-weight:700;line-height:1.3;color:var(--navy,#112f45)}.ds-metrics{margin:0}.ds-metrics>div{display:flex;justify-content:space-between;gap:12px;align-items:center;min-height:48px;border-bottom:1px solid var(--border,#dce6e8)}.ds-metrics>div:last-child{border-bottom:0}.ds-metrics dt{display:flex;align-items:center;gap:13px;color:var(--muted,#566b77);font-size:16px}.ds-metrics dd{margin:0;font-size:28px;font-weight:700;color:var(--navy,#112f45);font-variant-numeric:tabular-nums}.ds-dot{width:13px;height:13px;border-radius:50%;background:var(--ocean,#006f7b)}@media(max-width:639px){.ds-panel{padding:20px}.ds-report-heading{gap:16px}.ds-report-heading>span{width:56px;height:56px}}"
    },
    {
      "name": "Allocation ring",
      "kind": "custom",
      "description": "Data-derived allocation percentage with visible text; illustrative 50% sample.",
      "html": "<div class=\"ds-ring\" role=\"img\" aria-label=\"50% allocated\"><svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"none\" stroke=\"var(--border,#dce6e8)\" stroke-width=\"11\"/><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"none\" stroke=\"var(--ocean,#006f7b)\" stroke-width=\"11\" stroke-linecap=\"round\" pathLength=\"100\" stroke-dasharray=\"50 100\" transform=\"rotate(-90 60 60)\"/></svg><strong>50%</strong></div>",
      "css": ".ds-ring{width:160px;aspect-ratio:1;position:relative;font-family:'Segoe UI',Arial,sans-serif}.ds-ring svg{display:block;width:100%;height:100%}.ds-ring strong{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:clamp(24px,2vw,34px);color:var(--navy,#112f45)}@media(max-width:639px){.ds-ring{width:150px}}"
    },
    {

  "narrative": {
    "northStar": "Rihla work panels",
    "overview": "The staff application inherits Rihla's navy shell, teal actions, pale canvas and bilingual UI language. Clear white panels and restrained color separate report groups while keeping dense numeric content easy to scan.\n\nThis record describes the shipped dashboard and login sources, especially src/app/globals.css, the dashboard feature components and shared controls. The approved work-panels direction supplies the name; implemented source supplies the rules. Future management screens have not been implemented or documented here.",
    "keyCharacteristics": [
      "Navy structure, teal action and allocation, white bordered report surfaces.",
      "Locale-aware Arabic and English typography with mirrored start-side navigation.",
      "Large tabular metrics, labeled status colors and explicit data provenance.",
      "Flat report surfaces with subtle control feedback."
    ],
    "rules": [
      {
        "name": "The Labeled Status Rule",
        "body": "Pair every colored status dot with a visible localized label; the allocation chart also exposes its percentage as text and an accessible name.",
        "section": "colors"
      },
      {
        "name": "The Exact Amount Rule",
        "body": "Preserve localized gross-paid currency, both fractional digits and bidi isolation; its visual prominence must not turn gross paid into a claim of net revenue or payouts.",
        "section": "typography"
      },
      {
        "name": "The Flat Reports Rule",
        "body": "Use border and surface tone to separate reports; keep button shadows scoped to their existing control variants.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the existing Rihla identity, localized labels and logical RTL spacing.",
      "Do pair status color with text and preserve the allocation chart's visible percentage.",
      "Do retain payment basis, separate update timestamps and exact localized currency presentation.",
      "Do keep capacity full-width at tablet sizes and retain readable mobile control targets."
    ],
    "donts": [
      "Don't convert flat report panels into elevated decorative cards.",
      "Don't use English display typography for Arabic content or general body text.",
      "Don't remove loading, zero-data or partial-failure feedback when extending the report UI.",
      "Don't treat preview data or the approved composition image as operational evidence."
    ]

# API settings
NODE_ENV=development
PORT=4000
# Comma-separated exact origins, without a trailing slash or paths.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Match the root Docker .env settings; URL-encode the password.
DATABASE_URL=postgresql://bus:replace-with-your-local-password@127.0.0.1:5432/bus_platform

# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_CODE_SECRET=replace-with-64-hexadecimal-characters
# Mailjet Send API credentials; EMAIL_FROM must be a verified sender in Mailjet.
MJ_APIKEY=
MJ_SECRETKEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Rihla

# Independent random 32-byte hex key for signing access tokens.
AUTH_ACCESS_SECRET=replace-with-another-64-hexadecimal-key

# Optional Paymob TEST adapter. Disabled until TEST card payment setup is verified.
PAYMOB_ENABLED=false
# PAYMOB_SECRET_KEY=sk_test_replace_me
# PAYMOB_PUBLIC_KEY=pk_test_replace_me
# PAYMOB_API_KEY=replace_me
# PAYMOB_HMAC_SECRET=replace_me
# PAYMOB_INTEGRATION_ID=123456
# PAYMOB_OWNER_ID=123456
# PAYMOB_NOTIFICATION_URL=https://your-api.example.com/api/v1/payments/paymob/webhook
# Local TEST browser return; production must use the HTTPS website result URL.
# PAYMOB_RETURN_URL=http://localhost:3000/ar/checkout/result

# Receive signed notifications without enabling checkout. Apply migrations first.
PAYMOB_WEBHOOK_ENABLED=false
# OWNER_ID may remain empty for initial receipt; inquiry must establish it before paid booking.

# Independent 32-byte hex key for encrypted checkout URLs (checkout encryption; keep this key stable).
# PAYMENT_CHECKOUT_SECRET=replace-with-another-64-hexadecimal-key

# Opt-in TEST financial reconciliation. Keep false until TEST card payments is verified.
PAYMOB_RECONCILIATION_ENABLED=false

# Passenger TEST checkout: enable only after verified TEST card payments and agreed cancellation policy.
# Requires PAYMOB_ENABLED, PAYMOB_REFUNDS_ENABLED, owner-scoped webhook and reconciliation flags all true,
# reachable HTTPS callbacks and a running payment worker. Keep false during setup.
PAYMOB_CHECKOUT_ENABLED=false

# Enable only after validating TEST refunds for this account. Never enables LIVE payments.
PAYMOB_REFUNDS_ENABLED=false

# Keep local defaults. Containers bind 0.0.0.0 internally.
HOST=127.0.0.1
TRUST_PROXY_HOPS=0

# Optional: same independent key as Next for authenticated client-IP context.
# API_CLIENT_CONTEXT_SECRET=independent-64-hex-key-shared-only-with-next

# Private scheduled-job bearer token; generate with a cryptographic random generator.
# CRON_SECRET=replace-with-a-random-64-hexadecimal-key

# Optional read-only AI assistant. Keep the key on the API only.
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_TOOL_STEPS=5
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000

# Template for host/container environment settings, or ignored apps/api/production.env.
# Supply environment variables through the host, or Docker --env-file explicitly.
# The npm :prod commands do not select this file automatically.
# Do not reuse development secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
# Keep 0 unless the API is reachable only through exactly one trusted proxy.
TRUST_PROXY_HOPS=0
CORS_ORIGINS=https://www.example.com,https://admin.example.com
# Use your deployment database connection string and its required TLS options.
# URL-encode the password; the development Compose service is not a production host.
DATABASE_URL=postgresql://bus:replace-with-a-long-random-password@db.example.com:5432/bus_platform
AUTH_CODE_SECRET=replace-with-64-random-hex-characters
AUTH_ACCESS_SECRET=replace-with-a-different-64-random-hex-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=noreply@example.com
# Set both or neither, according to your SMTP server.
# SMTP_USER=replace-me
# SMTP_PASSWORD=replace-me
PAYMOB_ENABLED=false
PAYMOB_WEBHOOK_ENABLED=false
PAYMOB_RECONCILIATION_ENABLED=false
PAYMOB_CHECKOUT_ENABLED=false
PAYMOB_REFUNDS_ENABLED=false
# Copy verified TEST settings from apps/api/.env.example when ready.

# Optional: same independent key as Next for authenticated client-IP context.
# API_CLIENT_CONTEXT_SECRET=independent-64-hex-key-shared-only-with-next

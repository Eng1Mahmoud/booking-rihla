// use prisma-8

model City {
  id       String    @id @default(uuid())
  nameAr   String
  nameEn   String
  stations Station[]
}

model Station {
  id     String @id @default(uuid())
  nameAr String
  nameEn String
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  originRoutes Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")

  @@index([cityId])
}

model Bus {
  id          String    @id @default(uuid())
  plateNumber String    @unique
  seatCount   Int
  isActive    Boolean   @default(true)
  busTypeId String?
  busType BusType? @relation(fields: [busTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  amenityLinks BusAmenity[]
  seatLayout SeatLayout?
  seats       BusSeat[]
  trips       Trip[]

  @@check(expression: sql`"seatCount" BETWEEN 1 AND 100`, name: "bus_seat_count_range")
}

model BusSeat {
  id     String @id @default(uuid())
  busId  String
  number Int
  bookings BookingSeat[]
  bus    Bus    @relation(fields: [busId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([busId, number])
  @@check(expression: sql`number BETWEEN 1 AND 100`, name: "bus_seat_number_range")
}

model Route {
  id String @id @default(uuid())
  originStationId String
  destinationStationId String
  estimatedDurationMinutes Int
  isActive Boolean @default(true)
  originStation Station @relation("RouteOrigin", fields: [originStationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destinationStation Station @relation("RouteDestination", fields: [destinationStationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  trips Trip[]

  @@unique([originStationId, destinationStationId])
  @@index([destinationStationId])
  @@check(expression: sql`"originStationId" <> "destinationStationId"`, name: "route_distinct_stations")
  @@check(expression: sql`"estimatedDurationMinutes" BETWEEN 1 AND 10080`, name: "route_duration_range")
}

enum TripStatus {
  SCHEDULED
  CANCELLED
}

model Trip {
  id String @id @default(uuid())
  routeId String
  busId String
  departureAt TimestamptzString
  arrivalAt TimestamptzString
  pricePiastres Int
  status TripStatus @default(SCHEDULED)
  cancelledAt TimestamptzString?
  cancellationReason String?
  bookings Booking[]
  route Route @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bus Bus @relation(fields: [busId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([routeId, departureAt])
  @@index([busId, status, departureAt])
  @@index([departureAt])
  @@check(expression: sql`"arrivalAt" > "departureAt"`, name: "trip_time_order")
  @@check(expression: sql`"pricePiastres" BETWEEN 0 AND 2147483647`, name: "trip_price_range")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  phone String
  role UserRole @default(USER)
  passwordHash String
  language String @default("ar")
  emailVerifiedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  isActive Boolean @default(true)
  loginFailures Int @default(0)
  lockedUntil TimestamptzString?
  sessions Session[]
  bookings Booking[]
  passwordReset PasswordReset?
  verification EmailVerification?
  emails EmailOutbox[]
  @@index([role, createdAt, id])
  @@index([phone])
  @@check(expression: sql`"loginFailures" BETWEEN 0 AND 5`, name: "user_login_failures")
  @@check(expression: sql`language IN ('ar', 'en')`, name: "user_language")
}

model EmailVerification {
  id String @id @default(uuid())
  userId String @unique
  codeHash String?
  expiresAt TimestamptzString
  attempts Int @default(0)
  resendAfter TimestamptzString
  windowStartedAt TimestamptzString
  sendCount Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([expiresAt], where: sql`"codeHash" IS NOT NULL`, name: "verification_code_expiry")
  @@check(expression: sql`attempts BETWEEN 0 AND 5 AND "sendCount" BETWEEN 1 AND 5`, name: "verification_limits")
}

enum EmailPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  PASSWORD_CHANGED
}

model EmailOutbox {
  purpose EmailPurpose @default(VERIFY_EMAIL)
  id String @id @default(uuid())
  userId String
  encryptedCode String?
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
  nextAttemptAt TimestamptzString @default(now())
  attempts Int @default(0)
  sentAt TimestamptzString?
  discardedAt TimestamptzString?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([expiresAt], name: "account_email_expiry")
  @@index([sentAt, discardedAt, nextAttemptAt])
  @@check(expression: sql`attempts BETWEEN 0 AND 5`, name: "outbox_attempts")
}

model Session {
  id String @id @default(uuid())
  userId String
  createdAt TimestamptzString @default(now())
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokens RefreshToken[]
  @@index([expiresAt], name: "session_expiry")
  @@index([userId, revokedAt])
}

model RefreshToken {
  id String @id @default(uuid())
  sessionId String
  tokenHash String @unique
  createdAt TimestamptzString @default(now())
  expiresAt TimestamptzString
  usedAt TimestamptzString?
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([sessionId])
}

model PasswordReset {
  id String @id @default(uuid())
  userId String @unique
  codeHash String?
  expiresAt TimestamptzString
  consumedAt TimestamptzString?
  attempts Int @default(0)
  resendAfter TimestamptzString
  windowStartedAt TimestamptzString
  sendCount Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([expiresAt], where: sql`"codeHash" IS NOT NULL`, name: "reset_code_expiry")
  @@check(expression: sql`attempts BETWEEN 0 AND 5 AND "sendCount" BETWEEN 1 AND 5`, name: "password_reset_limits")
}

// Legacy reservations stay RESERVED; new checkout requests are expiring holds.
enum BookingStatus {
  RESERVED
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  CONFIRMED
  EXPIRED
}

model Booking {
  id String @id @default(uuid())
  reference String @unique
  userId String
  tripId String
  status BookingStatus @default(RESERVED)
  expiresAt TimestamptzString?
  contactPhone String
  seatCount Int
  unitPricePiastres Int
  totalPiastres BigInt
  createdAt TimestamptzString @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seats BookingSeat[]
  ticket Ticket?
  paymentAttempt PaymentAttempt?
  refund Refund?
  notices BookingNotice[]
  @@unique([id, tripId])
  @@index([status, expiresAt, tripId])
  @@check(expression: sql`("status" = 'RESERVED' AND "expiresAt" IS NULL) OR ("status" IN ('PENDING_PAYMENT', 'PAYMENT_PROCESSING', 'CONFIRMED', 'EXPIRED') AND "expiresAt" IS NOT NULL)`, name: "booking_hold_expiry")
  @@index([userId, createdAt])
  @@index([createdAt, id])
  @@index([tripId])
  @@check(expression: sql`"seatCount" BETWEEN 1 AND 100`, name: "booking_seat_count")
  @@check(expression: sql`"unitPricePiastres" BETWEEN 0 AND 2147483647 AND "totalPiastres" = "unitPricePiastres"::bigint * "seatCount"`, name: "booking_price_total")
}

model BookingSeat {
  id String @id @default(uuid())
  bookingId String
  tripId String
  seatId String
  seatNumber Int
  passengerName String
  releasedAt TimestamptzString?
  booking Booking @relation(fields: [bookingId, tripId], references: [id, tripId], onDelete: Cascade, onUpdate: Restrict)
  seat BusSeat @relation(fields: [seatId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([tripId, seatId], unique: true, where: sql`"releasedAt" IS NULL`, name: "booking_seat_active_unique")
  @@index([bookingId, tripId])
  @@index([seatId])
  @@check(expression: sql`"seatNumber" BETWEEN 1 AND 100`, name: "booking_seat_number")
}

model BusType {
  id String @id @default(uuid())
  code String @unique
  nameAr String
  nameEn String
  buses Bus[]
  @@check(expression: sql`code ~ '^[A-Z][A-Z0-9_]{0,31}$'`, name: "bus_type_code")
}
model Amenity {
  id String @id @default(uuid())
  code String @unique
  nameAr String
  nameEn String
  buses BusAmenity[]
  @@check(expression: sql`code ~ '^[A-Z][A-Z0-9_]{0,31}$'`, name: "amenity_code")
}
model BusAmenity {
  id String @id @default(uuid())
  busId String
  amenityId String
  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([busId, amenityId])
  @@index([amenityId])
}

enum SeatLayout {
  STANDARD_2_2
}

// Durable receipt only. Signed callbacks require authenticated inquiry and a
// matching payment attempt before they can affect bookings or seat allocations.
model PaymentEvent {
  id String @id @default(uuid())
  eventKey String @unique
  transactionId String
  orderId String
  integrationId String
  ownerId String
  signedJson String
  receivedAt TimestamptzString @default(now())
  @@index([orderId, receivedAt])
  @@index([transactionId, receivedAt])
  @@check(expression: sql`"eventKey" ~ '^[a-f0-9]{64}$'`, name: "payment_event_key")
}

// Immutable preparation snapshot. No provider request or collected funds yet.
model PaymentAttempt {
  id String @id @default(uuid())
  bookingId String @unique
  idempotencyKey String
  amountPiastres BigInt
  currency String @default("EGP")
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentSession PaymentSession?
  @@index([expiresAt])
  @@index([createdAt, id], name: "payment_attempt_created")
  @@check(expression: sql`"amountPiastres" BETWEEN 1 AND 214748364700 AND currency = 'EGP'`, name: "payment_attempt_amount")
  @@check(expression: sql`"expiresAt" > "createdAt"`, name: "payment_attempt_expiry")
  @@check(expression: sql`"idempotencyKey" ~ '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$'`, name: "payment_attempt_key")
}

// Durable send-once intention creation. READY means checkout created, never paid.
enum PaymentSessionStatus {
  REQUESTING
  READY
  UNKNOWN
  FAILED
  EXPIRED
}
model PaymentSession {
  id String @id @default(uuid())
  paymentAttemptId String @unique
  status PaymentSessionStatus @default(REQUESTING)
  integrationId String
  ownerId String
  intentionId String? @unique
  orderId String? @unique
  encryptedCheckoutUrl String?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  settlement PaymentSettlement?
  reconciliationComplete Boolean @default(false)
  nextReconcileAt TimestamptzString @default(now())
  attempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([status, updatedAt])
  @@index([reconciliationComplete, nextReconcileAt], name: "payment_reconcile_due")
  @@check(expression: sql`"integrationId" ~ '^[1-9][0-9]*$' AND "ownerId" ~ '^[1-9][0-9]*$'`, name: "payment_session_scope")
  @@check(expression: sql`"intentionId" IS NULL OR "orderId" IS NOT NULL`, name: "payment_session_references")
  @@check(expression: sql`("status" = 'READY' AND "encryptedCheckoutUrl" IS NOT NULL AND "intentionId" IS NOT NULL) OR ("status" <> 'READY' AND "encryptedCheckoutUrl" IS NULL)`, name: "payment_session_checkout")
}

// Verified direct-payment result. No authorization, capture or void operation.
enum PaymentSettlementKind {
 SALE
}
enum PaymentSettlementStatus {
 REQUESTED
 UNKNOWN
 SUCCEEDED
 REVIEW
}
model PaymentSettlement {
 id String @id @default(uuid())
 paymentSessionId String @unique
 transactionId String @unique
 kind PaymentSettlementKind
 status PaymentSettlementStatus @default(REQUESTED)
 amountPiastres BigInt
 createdAt TimestamptzString @default(now())
 updatedAt TimestamptzString @default(now())
 paymentSession PaymentSession @relation(fields: [paymentSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@index([status, updatedAt])
 @@check(expression: sql`"amountPiastres" BETWEEN 1 AND 214748364700`, name: "payment_settlement_amount")
 @@check(expression: sql`"transactionId" ~ '^[1-9][0-9]{0,15}$'`, name: "payment_settlement_transaction")
}

// Created atomically with verified payment confirmation; also the durable mail queue.
model Ticket {
  id String @id @default(uuid())
  bookingId String @unique
  createdAt TimestamptzString @default(now())
  sentAt TimestamptzString?
  discardedAt TimestamptzString?
  attempts Int @default(0)
  nextAttemptAt TimestamptzString @default(now())
  reminderSentAt TimestamptzString?
  reminderDiscardedAt TimestamptzString?
  reminderAttempts Int @default(0)
  reminderNextAttemptAt TimestamptzString @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([reminderSentAt, reminderDiscardedAt, reminderNextAttemptAt], name: "ticket_reminder_due")
  @@check(expression: sql`"reminderAttempts" BETWEEN 0 AND 5`, name: "ticket_reminder_attempts")
  @@index([sentAt, discardedAt, nextAttemptAt], name: "ticket_mail_due")
  @@check(expression: sql`attempts BETWEEN 0 AND 5`, name: "ticket_mail_attempts")
}

// Full refunds for operator cancellation or an unfulfillable paid booking. Claims are never blindly resent.
enum RefundStatus {
  PENDING
  REQUESTED
  UNKNOWN
  SUCCEEDED
  REVIEW
}
model Refund {
  id String @id @default(uuid())
  bookingId String @unique
  amountPiastres BigInt
  status RefundStatus @default(PENDING)
  transactionId String? @unique
  requestedBy String?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([status, updatedAt])
  @@check(expression: sql`"amountPiastres" BETWEEN 1 AND 214748364700`, name: "refund_amount")
  @@check(expression: sql`"transactionId" IS NULL OR "transactionId" ~ '^[1-9][0-9]{0,15}$'`, name: "refund_transaction")
}
enum BookingNoticePurpose {
  TRIP_CANCELLED
  REFUND_SUCCEEDED
}
model BookingNotice {
  id String @id @default(uuid())
  bookingId String
  purpose BookingNoticePurpose
  createdAt TimestamptzString @default(now())
  nextAttemptAt TimestamptzString @default(now())
  attempts Int @default(0)
  sentAt TimestamptzString?
  discardedAt TimestamptzString?
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([bookingId, purpose])
  @@index([sentAt, discardedAt, nextAttemptAt])
  @@check(expression: sql`attempts BETWEEN 0 AND 5`, name: "booking_notice_attempts")
}

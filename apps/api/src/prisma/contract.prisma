// use prisma-8

model City {
  id       String    @id @default(uuid())
  nameAr   String
  nameEn   String
  stations Station[]
}

model Station {
  id     String @id @default(uuid())
  nameAr String
  nameEn String
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  originRoutes Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")

  @@index([cityId])
}

model Bus {
  id          String    @id @default(uuid())
  plateNumber String    @unique
  seatCount   Int
  isActive    Boolean   @default(true)
  seats       BusSeat[]
  trips       Trip[]

  @@check(expression: sql`"seatCount" BETWEEN 1 AND 100`, name: "bus_seat_count_range")
}

model BusSeat {
  id     String @id @default(uuid())
  busId  String
  number Int
  bookings BookingSeat[]
  bus    Bus    @relation(fields: [busId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([busId, number])
  @@check(expression: sql`number BETWEEN 1 AND 100`, name: "bus_seat_number_range")
}

model Route {
  id String @id @default(uuid())
  originStationId String
  destinationStationId String
  estimatedDurationMinutes Int
  isActive Boolean @default(true)
  originStation Station @relation("RouteOrigin", fields: [originStationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destinationStation Station @relation("RouteDestination", fields: [destinationStationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  trips Trip[]

  @@unique([originStationId, destinationStationId])
  @@index([destinationStationId])
  @@check(expression: sql`"originStationId" <> "destinationStationId"`, name: "route_distinct_stations")
  @@check(expression: sql`"estimatedDurationMinutes" BETWEEN 1 AND 10080`, name: "route_duration_range")
}

enum TripStatus {
  SCHEDULED
  CANCELLED
}

model Trip {
  id String @id @default(uuid())
  routeId String
  busId String
  departureAt TimestamptzString
  arrivalAt TimestamptzString
  pricePiastres Int
  status TripStatus @default(SCHEDULED)
  bookings Booking[]
  route Route @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bus Bus @relation(fields: [busId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([routeId, departureAt])
  @@index([busId, status, departureAt])
  @@index([departureAt])
  @@check(expression: sql`"arrivalAt" > "departureAt"`, name: "trip_time_order")
  @@check(expression: sql`"pricePiastres" BETWEEN 0 AND 2147483647`, name: "trip_price_range")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  phone String
  role UserRole @default(USER)
  passwordHash String
  language String @default("ar")
  emailVerifiedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  isActive Boolean @default(true)
  loginFailures Int @default(0)
  lockedUntil TimestamptzString?
  sessions Session[]
  bookings Booking[]
  passwordReset PasswordReset?
  verification EmailVerification?
  emails EmailOutbox[]
  @@check(expression: sql`"loginFailures" BETWEEN 0 AND 5`, name: "user_login_failures")
  @@check(expression: sql`language IN ('ar', 'en')`, name: "user_language")
}

model EmailVerification {
  id String @id @default(uuid())
  userId String @unique
  codeHash String
  expiresAt TimestamptzString
  attempts Int @default(0)
  resendAfter TimestamptzString
  windowStartedAt TimestamptzString
  sendCount Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@check(expression: sql`attempts BETWEEN 0 AND 5 AND "sendCount" BETWEEN 1 AND 5`, name: "verification_limits")
}

enum EmailPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  PASSWORD_CHANGED
}

model EmailOutbox {
  purpose EmailPurpose @default(VERIFY_EMAIL)
  id String @id @default(uuid())
  userId String
  encryptedCode String?
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
  nextAttemptAt TimestamptzString @default(now())
  attempts Int @default(0)
  sentAt TimestamptzString?
  discardedAt TimestamptzString?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([sentAt, discardedAt, nextAttemptAt])
  @@check(expression: sql`attempts BETWEEN 0 AND 5`, name: "outbox_attempts")
}

model Session {
  id String @id @default(uuid())
  userId String
  createdAt TimestamptzString @default(now())
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokens RefreshToken[]
  @@index([userId, revokedAt])
}

model RefreshToken {
  id String @id @default(uuid())
  sessionId String
  tokenHash String @unique
  createdAt TimestamptzString @default(now())
  expiresAt TimestamptzString
  usedAt TimestamptzString?
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([sessionId])
}

model PasswordReset {
  id String @id @default(uuid())
  userId String @unique
  codeHash String?
  expiresAt TimestamptzString
  consumedAt TimestamptzString?
  attempts Int @default(0)
  resendAfter TimestamptzString
  windowStartedAt TimestamptzString
  sendCount Int @default(1)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@check(expression: sql`attempts BETWEEN 0 AND 5 AND "sendCount" BETWEEN 1 AND 5`, name: "password_reset_limits")
}

// Reservations have no passenger cancellation or payment transition in this MVP.
enum BookingStatus {
  RESERVED
}

model Booking {
  id String @id @default(uuid())
  reference String @unique
  userId String
  tripId String
  status BookingStatus @default(RESERVED)
  contactPhone String
  seatCount Int
  unitPricePiastres Int
  totalPiastres BigInt
  createdAt TimestamptzString @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seats BookingSeat[]
  @@unique([id, tripId])
  @@index([userId, createdAt])
  @@index([tripId])
  @@check(expression: sql`"seatCount" BETWEEN 1 AND 100`, name: "booking_seat_count")
  @@check(expression: sql`"unitPricePiastres" BETWEEN 0 AND 2147483647 AND "totalPiastres" = "unitPricePiastres"::bigint * "seatCount"`, name: "booking_price_total")
}

model BookingSeat {
  id String @id @default(uuid())
  bookingId String
  tripId String
  seatId String
  seatNumber Int
  passengerName String
  booking Booking @relation(fields: [bookingId, tripId], references: [id, tripId], onDelete: Cascade, onUpdate: Restrict)
  seat BusSeat @relation(fields: [seatId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([tripId, seatId])
  @@index([bookingId, tripId])
  @@index([seatId])
  @@check(expression: sql`"seatNumber" BETWEEN 1 AND 100`, name: "booking_seat_number")
}

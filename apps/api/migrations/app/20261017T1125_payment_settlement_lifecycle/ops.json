    "execute": [
      {
        "description": "create table \"PaymentSettlement\"",
        "sql": "CREATE TABLE \"public\".\"PaymentSettlement\" (\n  \"amountPiastres\" int8 NOT NULL,\n  \"authorizationId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" text NOT NULL,\n  \"kind\" text NOT NULL,\n  \"status\" text DEFAULT 'REQUESTED' NOT NULL,\n  \"transactionId\" text NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"PaymentSettlement_kind_check_5f50b4db\" CHECK (\"kind\" IN ('CAPTURE', 'VOID')),\n  CONSTRAINT \"PaymentSettlement_status_check_83fae29f\" CHECK (\"status\" IN ('REQUESTED', 'UNKNOWN', 'SUCCEEDED', 'REVIEW')),\n  CONSTRAINT \"payment_settlement_amount_8155a401\" CHECK (\"amountPiastres\" BETWEEN 1 AND 214748364700),\n  CONSTRAINT \"payment_settlement_transaction_2901d1e8\" CHECK (\"transactionId\" ~ '^[1-9][0-9]{0,15}$')\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"PaymentSettlement\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"PaymentSettlement\""
        ]
      }
    ]
  },

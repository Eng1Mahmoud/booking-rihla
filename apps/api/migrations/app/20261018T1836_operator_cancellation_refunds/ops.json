          "\"public\".\"BookingNotice\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"BookingNotice\"",
        "sql": "CREATE TABLE \"public\".\"BookingNotice\" (\n  \"attempts\" int4 DEFAULT 0 NOT NULL,\n  \"bookingId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"discardedAt\" timestamptz,\n  \"id\" text NOT NULL,\n  \"nextAttemptAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"purpose\" text NOT NULL,\n  \"sentAt\" timestamptz,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"BookingNotice_purpose_check_698cbb9f\" CHECK (\"purpose\" IN ('TRIP_CANCELLED', 'REFUND_SUCCEEDED')),\n  CONSTRAINT \"booking_notice_attempts_4c896e7d\" CHECK (attempts BETWEEN 0 AND 5)\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"BookingNotice\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"BookingNotice\""
        ]
      }
    ]
  },

        "sql": "CREATE TABLE \"public\".\"Refund\" (\n  \"amountPiastres\" int8 NOT NULL,\n  \"bookingId\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" text NOT NULL,\n  \"requestedBy\" text,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"transactionId\" text,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Refund_status_check_d12710e0\" CHECK (\"status\" IN ('PENDING', 'REQUESTED', 'UNKNOWN', 'SUCCEEDED', 'REVIEW')),\n  CONSTRAINT \"refund_amount_8155a401\" CHECK (\"amountPiastres\" BETWEEN 1 AND 214748364700),\n  CONSTRAINT \"refund_transaction_8d4c9e2d\" CHECK (\"transactionId\" IS NULL OR \"transactionId\" ~ '^[1-9][0-9]{0,15}$')\n)",

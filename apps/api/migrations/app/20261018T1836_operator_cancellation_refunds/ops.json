    "id": "table.BookingNotice",
    "label": "Create table \"BookingNotice\"",
    "summary": "Creates table \"BookingNotice\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "BookingNotice"
      }
    },
    "precheck": [

    "execute": [
      {
        "description": "create table \"PaymentAuthorization\"",
        "sql": "CREATE TABLE \"public\".\"PaymentAuthorization\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"encryptedCheckoutUrl\" text,\n  \"id\" text NOT NULL,\n  \"integrationId\" text NOT NULL,\n  \"intentionId\" text,\n  \"orderId\" text,\n  \"ownerId\" text NOT NULL,\n  \"paymentAttemptId\" text NOT NULL,\n  \"status\" text DEFAULT 'REQUESTING' NOT NULL,\n  \"updatedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"PaymentAuthorization_status_check_c1795974\" CHECK (\"status\" IN ('REQUESTING', 'READY', 'UNKNOWN', 'FAILED', 'EXPIRED')),\n  CONSTRAINT \"payment_authorization_checkout_0fc4d81c\" CHECK ((\"status\" = 'READY' AND \"encryptedCheckoutUrl\" IS NOT NULL AND \"intentionId\" IS NOT NULL) OR (\"status\" <> 'READY' AND \"encryptedCheckoutUrl\" IS NULL)),\n  CONSTRAINT \"payment_authorization_references_e5a362ee\" CHECK ((\"intentionId\" IS NULL AND \"orderId\" IS NULL) OR (\"intentionId\" IS NOT NULL AND \"orderId\" IS NOT NULL)),\n  CONSTRAINT \"payment_authorization_scope_37324968\" CHECK (\"integrationId\" ~ '^[1-9][0-9]*$' AND \"ownerId\" ~ '^[1-9][0-9]*$')\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"PaymentAuthorization\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"PaymentAuthorization\""
        ]
      }
    ]
  },

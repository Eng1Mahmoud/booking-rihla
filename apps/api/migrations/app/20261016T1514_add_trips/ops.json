        "sql": "CREATE TABLE \"public\".\"Trip\" (\n  \"arrivalAt\" timestamptz NOT NULL,\n  \"busId\" text NOT NULL,\n  \"departureAt\" timestamptz NOT NULL,\n  \"id\" text NOT NULL,\n  \"pricePiastres\" int4 NOT NULL,\n  \"routeId\" text NOT NULL,\n  \"status\" text DEFAULT 'SCHEDULED' NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Trip_status_check_82227794\" CHECK (\"status\" IN ('SCHEDULED', 'CANCELLED')),\n  CONSTRAINT \"trip_price_range_00e5e7c7\" CHECK (\"pricePiastres\" BETWEEN 0 AND 2147483647),\n  CONSTRAINT \"trip_time_order_1a534dcc\" CHECK (\"arrivalAt\" > \"departureAt\")\n)",

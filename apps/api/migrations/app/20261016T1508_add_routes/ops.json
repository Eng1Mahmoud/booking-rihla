        "description": "create table \"Route\"",
        "sql": "CREATE TABLE \"public\".\"Route\" (\n  \"destinationStationId\" text NOT NULL,\n  \"estimatedDurationMinutes\" int4 NOT NULL,\n  \"id\" text NOT NULL,\n  \"isActive\" bool DEFAULT true NOT NULL,\n  \"originStationId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"route_distinct_stations_0ade44e1\" CHECK (\"originStationId\" <> \"destinationStationId\"),\n  CONSTRAINT \"route_duration_range_c4fded6c\" CHECK (\"estimatedDurationMinutes\" BETWEEN 1 AND 10080)\n)",
        "params": []
      }
    ],

{
  "name": "booking-bus",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @booking-bus/api",
    "build": "npm run build --workspace @booking-bus/api",
    "start": "npm run start --workspace @booking-bus/api",
    "typecheck": "npm run typecheck --workspace @booking-bus/api",
    "lint": "eslint apps/api/src apps/api/prisma.config.ts apps/web/src apps/dashboard/src --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "email:worker": "npm run email:worker --workspace @booking-bus/api",
    "dev:web": "npm run dev --workspace @booking-bus/web",
    "build:web": "npm run build --workspace @booking-bus/web",
    "typecheck:web": "npm run typecheck --workspace @booking-bus/web",
    "lint:web": "npm run lint --workspace @booking-bus/web",
    "dev:dashboard": "npm run dev --workspace @booking-bus/dashboard",
    "build:dashboard": "npm run build --workspace @booking-bus/dashboard",
    "typecheck:dashboard": "npm run typecheck --workspace @booking-bus/dashboard",
    "lint:dashboard": "npm run lint --workspace @booking-bus/dashboard"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}

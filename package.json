{
  "name": "booking-bus",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @booking-bus/api",
    "build": "npm run build --workspace @booking-bus/api",
    "start": "npm run start --workspace @booking-bus/api",
    "typecheck": "npm run typecheck --workspace @booking-bus/api",
    "test": "npm run test --workspace @booking-bus/api",
    "lint": "eslint apps/api/src apps/api/test apps/api/prisma.config.ts --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "contract:emit": "npm run contract:emit --workspace @booking-bus/api",
    "city:example": "npm run city:example --workspace @booking-bus/api",
    "test:db": "npm run test:db --workspace @booking-bus/api",
    "db:migrate": "npm run db:migrate --workspace @booking-bus/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
